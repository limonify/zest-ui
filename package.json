{
  "name": "@limonify/zest-monorepo",
  "private": true,
  "version": "0.0.1",
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "cd apps/example && bunx expo start",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "build": "turbo run build",
    "readme:sync": "cp README.md packages/zest-ui/README.md",
    "readme:check": "diff README.md packages/zest-ui/README.md"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@next/eslint-plugin-next": "^16.2.12",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7",
    "turbo": "^2.10.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
